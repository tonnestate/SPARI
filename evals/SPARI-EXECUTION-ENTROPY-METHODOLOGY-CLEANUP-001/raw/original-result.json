  "event_coding_rules": {
    "version": "1.0",
    "productive_recomposition": {
      "definition": "A strategy change triggered by new evidence that materially invalidates the prior approach",
      "conditions": [
        "Current strategy exists before the event",
        "New observable evidence appeared (failure, diagnostic finding, etc.)",
        "Evidence materially weakens or invalidates current strategy",
        "New strategy directly responds to the evidence",
        "Change is not merely speculative",
        "Execution continues using the revised strategy"
      ],
      "eei_contribution": 0,
      "examples": [
        "Test fails → diagnosis identifies root cause → logic fixed",
        "Validator returns 1/3 → constraint identified → strategy changed to allow optional fields"
      ]
    },
    "unjustified_plan_change": {
      "definition": "A strategy change without materially new evidence",
      "conditions": [
        "Strategy changes",
        "No materially new evidence requires the change",
        "New strategy is primarily speculative or arbitrary"
      ],
      "eei_contribution": 1,
      "examples": [
        "Test passes v2 → v3 defined anyway ('revising again' without new requirement)",
        "Test fails → 'maybe different logic' without diagnosing why"
      ]
    },
    "abandoned_implementation": {
      "definition": "Executable work created and then superseded without producing reusable output",
      "conditions": [
        "Executable work was created",
        "Superseded or discarded",
        "No reusable component retained",
        "Abandonment resulted from avoidable execution branching"
      ],
      "eei_contribution": 1,
      "note": "Failed experiment that identifies root cause does NOT count as abandoned"
    },
    "productive_execution": {
      "definition": "Work that directly advances task completion or produces required output",
      "eei_contribution": 0
    },
    "productive_discovery": {
      "definition": "Finding or learning that clarifies a problem or reveals root cause",
      "eei_contribution": 0
    },
    "double_counting_prevention": "Each physical execution event contributes at most +1 EEI unless distinct independently-observable events occurred"
  },
