{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPARI Engineering Case",
  "type": "object",
  "required": [
    "schema_version",
    "outcome",
    "known_evidence",
    "constraints",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.3"
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_context_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "type": "string"
    },
    "affected_capability": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_signal": {
      "type": [
        "string",
        "null"
      ]
    },
    "known_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "current_composition_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_attempts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradicting_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_memory_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trajectory_memory_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search_radius": {
      "enum": [
        "R0_RECALL",
        "R1_LOCAL",
        "R2_RELATED_INTERNAL",
        "R3_TARGETED_EXTERNAL",
        "R4_BROAD_EXTERNAL",
        null
      ]
    }
  }
}
